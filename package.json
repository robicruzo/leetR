{
	"name": "leetr",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve:pages": "node scripts/serve-pages.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"assets": "node scripts/fetch-assets.mjs",
		"content": "node scripts/content/check.mjs",
		"predev": "npm run assets && npm run content",
		"prebuild": "npm run assets && npm run content"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"codemirror": "^6.0.2",
		"dexie": "^4.4.7",
		"marked": "^18.2.1",
		"webr": "^0.6.1",
		"yaml": "^2.9.1"
	}
}
